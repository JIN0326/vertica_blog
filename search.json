---
layout: null
---
{% assign search_pages = site.pages | where_exp: "item", "item.title != nil" | where_exp: "item", "item.name != 'search.json'" | where_exp: "item", "item.name != '404.html'" | where_exp: "item", "item.name != '95search.md'" %}
{% assign search_posts = site.posts %}
{% assign all_search_items = search_pages | concat: search_posts %}
[
  {% for item in all_search_items %}
  {
    "title": {{ item.title | escape | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "category": {{ item.categories | join: ", " | jsonify }},
    "tags": {{ item.tags | join: ", " | jsonify }},
    "content": {{ item.description | append: ' ' | append: item.content | strip_html | strip_newlines | escape | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]